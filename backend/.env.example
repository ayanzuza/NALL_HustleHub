PORT=5443
NODE_ENV=development

# MongoDB connection string (local: mongodb://127.0.0.1:27017/hustlehub, or an Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/hustlehub

# Generate a strong random secret, e.g.:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=1h

# Path to local HTTPS certs (see certs/generate-cert.sh)
SSL_KEY_PATH=certs/key.pem
SSL_CERT_PATH=certs/cert.pem

# React frontend origin(s) allowed by CORS (comma-separated)
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate limiting (requests per window per IP). Raise RATE_LIMIT_AUTH_MAX when running Newman.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_BOOKING_MAX=20
RATE_LIMIT_GLOBAL_MAX=300
