        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Freelancer Bravo\",\n  \"email\": \"flb_{{runId}}@example.com\",\n  \"password\": \"StrongPass1!\",\n  \"role\": \"freelancer\"\n}"
