{
  "info": {
    "name": "HustleHub+ - Part 2 (Secure Stack)",
    "description": "End-to-end API tests: auth, RBAC, gig ownership, bookings -> transactions, income, sanitisation and security headers. Run with: newman run <file> --insecure",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:5443/api"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "tokenA",
      "value": ""
    },
    {
      "key": "tokenB",
      "value": ""
    },
    {
      "key": "tokenC",
      "value": ""
    },
    {
      "key": "idA",
      "value": ""
    },
    {
      "key": "idB",
      "value": ""
    },
    {
      "key": "idC",
      "value": ""
    },
    {
      "key": "gigId",
      "value": ""
    },
    {
      "key": "gigId2",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId', String(Date.now()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Register Freelancer A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Freelancer Alpha\",\n  \"email\": \"fla_{{runId}}@example.com\",\n  \"password\": \"StrongPass1!\",\n  \"role\": \"freelancer\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('JWT issued', () => pm.expect(json.data.token).to.be.a('string'));",
              "pm.test('Hash never exposed', () => pm.expect(pm.response.text()).to.not.include('passwordHash'));",
              "pm.collectionVariables.set('tokenA', json.data.token); pm.collectionVariables.set('idA', json.data.user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Register Freelancer B",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
